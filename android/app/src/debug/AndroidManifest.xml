<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- X-6e (docs-and-plan#164): plain HTTP is allowed in debug builds only,
         for a backend on the LAN or the emulator host
         (--dart-define=API_BASE_URL=http://10.0.2.2:8080). Release builds
         leave it at the Android default (off since API 28), so the app can
         only reach the backend over HTTPS. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
